import pandas as pd
import matplotlib.pyplot as plt
import scipy.stats as stats

age = [23,23,27,27,39,41,47,49,50,52,54,54,56,57,58,58,60,61]
fat = [9.5,26.5,7.8,17.8,31.4,25.9,27.4,27.2,31.2,34.6,42.5,28.8,33.4,30.2,34.1,32.9,41.2,35.7]
df = pd.DataFrame({"age": age, "%fat": fat})

print("Q18 - DESCRIPTIVE STATISTICS")
print(df.agg(["mean", "median", "std"]).round(2))

plt.figure()
df.boxplot()
plt.title("Boxplots of Age and Body Fat")
plt.savefig("Q18_OUTPUT_BOXPLOT.png")
plt.show()

plt.figure()
plt.scatter(age, fat)
plt.xlabel("Age")
plt.ylabel("Body Fat (%)")
plt.title("Age vs Body Fat")
plt.savefig("Q18_OUTPUT_SCATTER.png")
plt.show()

plt.figure()
stats.probplot(age, dist="norm", plot=plt)
plt.title("Q-Q Plot - Age")
plt.savefig("Q18_OUTPUT_QQ_AGE.png")
plt.show()

plt.figure()
stats.probplot(fat, dist="norm", plot=plt)
plt.title("Q-Q Plot - Body Fat")
plt.savefig("Q18_OUTPUT_QQ_FAT.png")
plt.show()
