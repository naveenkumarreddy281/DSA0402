import pandas as pd
import re
from collections import Counter
import matplotlib.pyplot as plt

df = pd.read_csv("data.csv")
stop = {"the", "and", "is", "a", "to", "of", "for", "this", "it", "in", "was"}
text = " ".join(df["feedback"].fillna("").astype(str)).lower()
words = re.findall(r"\b[a-z]+\b", text)
freq = Counter(w for w in words if w not in stop)

n = int(input("Enter top N words: "))
top = freq.most_common(n)

print("\\nQ17 - TOP WORD FREQUENCIES")
print("--------------------------")
for word, count in top:
    print(f"{word}: {count}")

if top:
    labels, values = zip(*top)
    plt.bar(labels, values)
    plt.title("Top N Customer Feedback Words")
    plt.xlabel("Words")
    plt.ylabel("Frequency")
    plt.tight_layout()
    plt.savefig("Q17_OUTPUT_GRAPH.png")
    plt.show()
