import pandas as pd
data = {
    'customer_id': [1, 2, 1, 3, 2],
    'order_date': ['2026-01-01', '2026-01-02', '2026-01-03', '2026-01-04', '2026-01-05'],
    'product_name': ['Pen', 'Book', 'Pen', 'Bag', 'Book'],
    'order_quantity': [2, 3, 4, 1, 5]
}
order_data = pd.DataFrame(data)
print("1. Orders by customer:")
print(order_data.groupby('customer_id').size())
print("2. Average quantity by product:")
print(order_data.groupby('product_name')['order_quantity'].mean())
order_data['order_date'] = pd.to_datetime(order_data['order_date'])
print("3. Earliest date:", order_data['order_date'].min())
print("Latest date:", order_data['order_date'].max())
