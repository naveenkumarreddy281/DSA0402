import numpy as np
from scipy import stats

# Illustrative data: 25 drug and 25 placebo patients (question gives no raw data)
drug = [12,15,10,14,13,16,11,12,17,14,15,13,10,16,12,14,18,11,13,15,12,14,16,13,15]
placebo = [5,7,4,6,8,3,5,6,4,7,5,8,6,4,5,7,3,6,5,4,8,6,5,7,4]

def ci95(data):
    mean = np.mean(data)
    sem = stats.sem(data)
    low, high = stats.t.interval(0.95, len(data)-1, loc=mean, scale=sem)
    return mean, low, high

print("Q19 - 95% CONFIDENCE INTERVAL")
for name, data in [("Drug", drug), ("Placebo", placebo)]:
    mean, low, high = ci95(data)
    print(f"{name}: Mean = {mean:.2f}")
    print(f"95% CI = ({low:.2f}, {high:.2f})")
